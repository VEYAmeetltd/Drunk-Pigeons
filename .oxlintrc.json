{
  "ignorePatterns": ["**/node_modules/**", "**/dist/**", "**/.expo/**", "**/web-build/**"],
  "rules": {
    "no-undef": "off"
  },
  "globals": {
    "define": "readonly",
    "module": "writable",
    "require": "readonly",
    "exports": "writable",
    "process": "readonly",
    "__DEV__": "readonly",
    "java": "readonly",
    "_": "readonly",
    "PR": "readonly"
  }
}
