{
  "expo": {
    "name": "Drunk Pigeons",
    "slug": "drunk-pigeons",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "backgroundColor": "#1b1030",
    "icon": "./assets/icon.png",
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.drunkpigeons.app",
      "infoPlist": {
        "NSUserTrackingUsageDescription": "This lets us show more relevant ads and keep Drunk Pigeons free."
      }
    },
    "android": {
      "package": "com.drunkpigeons.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#070B35"
      }
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "backgroundColor": "#070B35",
          "resizeMode": "contain"
        }
      ]
    ],
    "react-native-google-mobile-ads": {
      "android_app_id": "ca-app-pub-1908215441963534~6037769588",
      "ios_app_id": "ca-app-pub-1908215441963534~2962732884"
    }
  }
}
